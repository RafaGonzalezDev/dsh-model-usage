{
  "name": "dsh-model-usage-workspace",
  "version": "0.4.5",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace dsh-model-usage",
    "build:host": "npm run build:host --workspace dsh-model-usage",
    "build:client": "npm run build:client --workspace dsh-model-usage",
    "typecheck": "npm run build:host && tsc -b tsconfig.host.json tsconfig.client.json",
    "test": "node --test --test-isolation=none test/*.test.ts",
    "check": "npm run build && npm test",
    "pack:plugin": "npm pack --workspace dsh-model-usage --pack-destination .",
    "verify:usage": "node scripts/verify-usage.ts"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-api-remotes": "0.2.0-rc.2",
    "@deepseek-ai/dsh-app-boot": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-store": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session-persistence": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session-query": "0.2.0-rc.2",
    "@deepseek-ai/dsh-typert-generator": "0.2.0-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.0-rc.2",
    "@deepseek-ai/dsh-util-time": "0.2.0-rc.2",
    "@types/node": "24.19.0",
    "@types/react": "18.3.31",
    "react": "^18.3.1",
    "semver": "7.8.5",
    "tsdown": "0.23.0",
    "typescript": "7.0.2"
  }
}
